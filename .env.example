# Copy this file to .env and fill in your values

# Jira
JIRA_BASE_URL=https://jira.fyiblue.com
JIRA_API_TOKEN=your-jira-token-here
JIRA_VERIFY_SSL=true

# LLM + Embeddings (OpenAI)
OPENAI_API_KEY=your-openai-key-here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-large

# Vector DB (Pinecone) — leave blank to use in-memory indexes
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
COARSE_INDEX_NAME=tickets_coarse
FINE_INDEX_NAME=tickets_fine
SUPERVISION_STORE=tickets_supervision

# Entity dictionaries
ENTITY_DICT_PATH=data/entity_dicts/
ENTITY_DICT_REFRESH=daily

# Extraction settings
OCR_ENABLED=true
MAX_SLIDES=60
MAX_SUPPLEMENTARY=2
